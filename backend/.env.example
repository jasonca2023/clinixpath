# OpenAI is the primary analysis provider. Keep this file local: it is ignored
# by Git and must never be committed. Create a fresh key at the URL below;
# revoked or exposed keys must not be reused.
LLM_PROVIDER=openai
OPENAI_API_KEY=your_new_key_here
LLM_MODEL=gpt-4.1-mini
# → https://platform.openai.com/api-keys

# Optional fallbacks. When OpenAI is unavailable, each configured provider below
# is tried in this order: Cloudflare, then Groq, then the other supported presets.
GROQ_API_KEY=your_key_here
# → https://console.groq.com/keys

# Cloudflare Workers AI needs BOTH values because the account id is in its URL.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_token_here
# → account id: right-hand sidebar of any dash.cloudflare.com page
# → token:      dash.cloudflare.com/profile/api-tokens, "Workers AI" template

# CEREBRAS_API_KEY=your_key_here
# → https://cloud.cerebras.ai            (fastest of all, but free context caps
#                                         at 8,192 tokens — too small for a chart)

# TOGETHER_API_KEY=your_key_here
# → https://api.together.ai/settings/api-keys

# Paid, but strongest quality:
# ANTHROPIC_API_KEY=your_key_here
# → https://console.anthropic.com/settings/keys

# DEEPSEEK_API_KEY=your_key_here
# → https://platform.deepseek.com/api_keys

# ---------------------------------------------------------------------------
# Fully offline: no signup, no key, no data leaves your machine at all:
#   brew install ollama && ollama serve && ollama pull llama3.3
#   then uncomment:
# LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------

# Optional overrides (any provider):
# LLM_PROVIDER=groq          # force a fallback provider instead of OpenAI
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://...   # custom gateway / self-hosted OpenAI-compatible server
# LLM_API_KEY=...            # generic key for a custom gateway

# Optional. Comma-separated origins allowed to call this API.
# Defaults to localhost/127.0.0.1 on ports 5173 and 4173.
# ALLOWED_ORIGINS=http://localhost:5173

# Trial criteria come from the public ClinicalTrials.gov API v2 (no key required).

# Optional. Comma-separated hosts this service may fetch a trial URL from.
# A URL containing an NCT id always goes to the registry API and ignores this.
# Anything else is fetched by the SERVER, using the server's network position, so
# by default only public addresses are allowed: private, loopback and link-local
# ranges (including the 169.254.169.254 cloud metadata endpoint) are refused.
# Set this to narrow it further to an explicit allowlist.
# TRIAL_URL_HOSTS=clinicaltrials.gov,www.clinicaltrials.gov
